# ---- Postgres (docker-compose) ----
POSTGRES_USER=banking
POSTGRES_PASSWORD=changeme
POSTGRES_DB=banking_dw
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ---- Data pipeline ----
PIPELINE_SEED=42
N_DEBITUR=6000
PANEL_YEARS=3
# SAMPLE_MODE=1 membatasi baris yang dibaca dari SBAnational.csv dan LI-Small_Trans.csv
SAMPLE_MODE=0
# Muat tabel gold ke Postgres di akhir flow
LOAD_TO_POSTGRES=0

# ---- Prefect ----
# JANGAN aktifkan PREFECT_API_URL di sini. config.py memanggil load_dotenv(),
# sehingga variabel ini masuk ke SETIAP proses - termasuk saat menjalankan
# `python -m pipelines.flows.main_flow` tanpa server. Prefect lalu mencoba
# menghubungi server yang tidak hidup dan pipeline gagal sebelum mulai.
# Setel di terminal hanya saat memakai server:
#     export PREFECT_API_URL=http://127.0.0.1:4200/api
# PREFECT_API_URL=http://127.0.0.1:4200/api

# Dipakai oleh langkah pull di prefect.yaml
PREFECT_PROJECT_DIR=.

# ---- Copilot: LLM lokal, RAG, agen ----
# Profil model. 'terpadu' (~5 GB, bawaan) menyamakan seluruh peran copilot ke
# qwen2.5:7b-instruct, bobot yang sama dengan lapisan ml/agentic_ai, supaya
# Ollama tidak memuat dua generasi Qwen sekaligus. 'hemat' (~2,3 GB) untuk sesi
# tanpa GPU; 'seimbang' (~8 GB) memakai SahabatAI + Qwen 7B.
COPILOT_PROFIL=hemat

# Alamat server Ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# Tag SahabatAI untuk profil 'seimbang'. Tidak ada nilai bawaan: repo GGUF-nya
# adalah kuantisasi pihak ketiga yang berubah-ubah, jadi tagnya harus Anda
# verifikasi sendiri. Lihat copilot/README.md.
# COPILOT_MODEL_SAHABAT=hf.co/<pengguna>/<repo-gguf-sahabatai>:Q4_K_M

# Menimpa profil per peran, bila hanya satu peran yang ingin dibesarkan.
# COPILOT_MODEL_EKSTRAKSI=
# COPILOT_MODEL_CHAT=
# COPILOT_MODEL_AGEN=qwen2.5:7b-instruct
# COPILOT_MODEL_EMBEDDING=nomic-embed-text

# Anggaran memori untuk peringatan di sidebar antarmuka. Catatan: angka ini
# hanya menjumlahkan peran copilot, belum termasuk VLM yang dimuat lapisan
# agentic AI di server Ollama yang sama.
COPILOT_ANGGARAN_GB=13

# ---- Agentic AI (ml/agentic_ai) ----
# Nilai bawaan di ml/agentic_ai/config.py sudah sesuai profil 'terpadu', jadi
# blok ini hanya perlu diisi bila ingin menyimpang.
# QWEN_AGENT_MODEL=qwen2.5:7b-instruct      # memilih 4 tool ML + query_credit_policy
# QWEN_NARRATOR_MODEL=qwen2.5:7b-instruct   # narasi risiko Bahasa Indonesia
# QWEN_EXTRACTOR_MODEL=qwen2.5:7b-instruct  # fallback semantik, mati secara bawaan
# VLM_MODEL=qwen3-vl:4b-instruct            # transkripsi halaman hasil scan

# JANGAN diisi kecuali memang ingin narrator memakai SahabatAI: narrator
# membaca QWEN_NARRATOR_MODEL -> SAHABAT_MODEL -> QWEN_AGENT_MODEL secara
# berurutan, jadi nilai sisa dari V7 di sini akan diam-diam menang.
# SAHABAT_MODEL=

# Fallback ekstraksi semantik Qwen. Bawaan mati: pemetaan angka laporan
# keuangan ditangani DeterministicDocumentMapper di Python, bukan LLM.
# AI_QWEN_SEMANTIC_FALLBACK=0

# RAG kebijakan yang dipanggil agent lewat tool query_credit_policy.
# AI_RAG_ENABLED=1
# AI_RAG_TOP_K=5

# Batas putaran tool calling. Agen yang tidak berhenti menghabiskan sesi
# notebook, bukan sekadar melambat.
COPILOT_MAKS_PUTARAN=8

# Bobot skor leksikal pada peringkat RAG (sisanya kosinus). Menaikkannya
# menguntungkan kueri beristilah persis peraturan; 0 mengembalikan pencarian
# dense murni.
COPILOT_BOBOT_LEKSIKAL=0.35


METABASE_EMBED_URL=http://localhost:3000/public/dashboard/a5c384cf-5a95-4d17-bb14-5aa5787e65b4